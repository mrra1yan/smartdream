# =============================================================================
# SmartDream environment (MySQL + Redis, no Supabase)
# Copy to .env.local and fill in real values. Never commit .env.local.
# =============================================================================

# ---- MySQL (docker-compose service `mysql`) ----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=smartdream
MYSQL_USER=smartdream
MYSQL_PASSWORD=smartdream_dev_password
MYSQL_ROOT_PASSWORD=root_dev_password
# InnoDB buffer pool in MB (default 2048; tune to ~70% of VPS RAM)
MYSQL_BUFFER_POOL_MB=2048

# ---- Redis (docker-compose service `redis`) ----
REDIS_URL=redis://127.0.0.1:6379

# ---- Session auth ----
# HS256 signing secret for the session JWT. MUST be a long random string.
# (Same variable name as the legacy ad-token secret; reused deliberately —
# both are jose HS256 JWTs. Change for production.)
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Session cookie name (single cookie, replaces the sb-*-auth-token pair)
SESSION_COOKIE_NAME=sd_session

# ---- App config ----
APP_LATEST_VERSION=1.0.0
APP_FORCE_UPDATE=false
APP_DOWNLOAD_URL=
APP_RELEASE_NOTES=
NODE_ENV=development
