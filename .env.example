# =============================================================================
# SmartDream environment (PostgreSQL + Redis)
# Copy to .env.local and fill in real values. Never commit .env.local.
# =============================================================================

# ---- PostgreSQL ----
DATABASE_URL=postgresql://smartdream:smartdream_dev_password@127.0.0.1:5432/smartdream

# Docker compose env (used by docker-compose.yml)
POSTGRES_DB=smartdream
POSTGRES_USER=smartdream
POSTGRES_PASSWORD=smartdream_dev_password

# Pool settings (optional)
PG_POOL_MAX=20
PG_CONNECT_TIMEOUT_MS=10000

# ---- Redis (docker-compose service `redis`) ----
REDIS_URL=redis://127.0.0.1:6379

# ---- Session auth ----
# HS256 signing secret for the session JWT. MUST be a long random string.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Session cookie name
SESSION_COOKIE_NAME=sd_session

# ---- App config ----
APP_LATEST_VERSION=1.0.0
APP_FORCE_UPDATE=false
APP_DOWNLOAD_URL=
APP_RELEASE_NOTES=
APP_WEB_URL=https://sd.docstec.cloud
NODE_ENV=production
